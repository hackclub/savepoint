<%# locals: (plain: false) %>
<%# The footer on every participant page. The landing page's is a dark zone (footer.css) under the FAQ's slanted foot. On the
    other pages (plain: true) it is just the two lines on the page's own background. %>
<% links = capture do %>
  <p><a href="https://hackclub.com">Hack Club</a> · <a href="https://hackclub.com/privacy-and-terms">Terms &amp; Privacy</a> · <a href="https://forms.hackclub.com/bounty">Fulfillment</a> · <a href="https://security.hackclub.com">Security</a><% if NpsResponse.participant?(current_user) %> · <%= link_to "Feedback", nps_path %><% end %></p>
  <p class="muted">made with &lt;3 by <a target="_blank" rel="noopener" href="https://hackclub.enterprise.slack.com/team/U07ABEP916X">@armand</a></p>
<% end %>
<% if plain %>
  <div class="wrap-plain"><footer class="foot foot--plain"><%= links %></footer></div>
<% else %>
  <div class="zone zone--foot zone--dark">
    <div class="wrap">
      <footer class="foot"><%= links %></footer>
    </div>
  </div>
<% end %>
