<%# The FAQ renders from Faq (D-093): each group has a fixed anchor (#shipping) and each question a stable key for its id (#shipping.what-does-my-repository-need).
    The old #faq-N still opens the Nth question (faq_controller.js). One question is open at a time and its read time is recorded (D-094). %>
<% number = 0 %>
<% groups = Faq.groups(self) %>
<div class="faq">
  <% [ groups.first(2), groups.drop(2) ].each do |column| %>
    <div class="faq__col">
      <% column.each do |group| %>
        <div class="faq__group" id="<%= group.slug %>">
          <h3 class="faq__title"><%= group.title %></h3>
          <div class="sp-faq">
            <% group.entries.each do |entry| %>
              <details id="<%= entry.key %>" data-controller="faq" data-faq-number-value="<%= number += 1 %>" data-faq-key-value="<%= entry.key %>" data-faq-url-value="<%= faq_reads_path %>"
                       data-action="faq:opened@window->faq#closeOthers">
                <summary data-faq-target="summary" data-action="click->faq#toggle"><%= entry.question %><%= sp_icon "down-fill" %></summary>
                <div data-faq-target="content"><p><%= entry.answer %></p></div>
              </details>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
