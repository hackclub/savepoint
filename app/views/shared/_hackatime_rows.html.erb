<%# locals: (choices:, type: "checkbox", name: nil, input_data: {}, selected: nil, label: "Your Hackatime projects") %>
<%# The Hackatime projects you can pick, always open: a row for each, with a coin that is ticked when the project is
    linked, the project's name and its hours. Rows are pills, and everything inside one sits 6px from its edge (the hours
    pill's 3px lip counts), so the coin, the hours pill and the gold coin in it are concentric (hackatime_picker.css).
    selected: the one name that's picked (radios), else each choice's own linked flag. A checkbox has no name: the
    picker sends the ticked ones itself (hackatime_picker_controller.js), so a form around it never carries them. %>
<div class="hkp__list" role="<%= type == "radio" ? "radiogroup" : "group" %>" aria-label="<%= label %>">
  <% choices.each do |choice| %>
    <% hours = choice[:note].to_s.delete_suffix(" hrs") if choice[:note].to_s.end_with?(" hrs") %>
    <label class="hkp__row">
      <%= tag.input type:, name:, value: choice[:name], class: "hkp__input", checked: (selected ? selected == choice[:name] : choice[:linked]),
            data: { hackatime_picker_target: ("box" if type == "checkbox") }.merge(input_data) %>
      <span class="hkp__coin" aria-hidden="true"><%= sp_icon "check-fill" %></span>
      <span class="hkp__label">
        <span class="hkp__name"><%= choice[:name] %></span>
        <% if choice[:other_repo] %>
          <span class="hkp__warning"><%= sp_icon "warning-fill" %>Hackatime links this to a different repo</span>
        <% end %>
      </span>
      <% if hours %>
        <span class="hkp__hours sp-stat"><span class="sp-stat__key"><%= sp_icon "time-fill" %></span><%= hours %><span class="sp-stat__unit">hrs</span></span>
      <% else %>
        <span class="hkp__note"><%= choice[:note] %></span>
      <% end %>
    </label>
  <% end %>
</div>
