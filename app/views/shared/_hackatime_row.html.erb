<%# locals: (choice:, type:, name:, input_data:, selected:) %>
<%# One row of the Hackatime picker (shared/_hackatime_rows). %>
<% hours = choice[:note].to_s.delete_suffix(" hrs") if choice[:note].to_s.end_with?(" hrs") %>
<label class="hkp__row">
  <%= tag.input type:, name:, value: choice[:name], class: "hkp__input", checked: (selected ? selected == choice[:name] : choice[:linked]),
        data: { hackatime_picker_target: ("box" if type == "checkbox") }.merge(input_data) %>
  <span class="hkp__coin" aria-hidden="true"><%= sp_icon "check-fill" %></span>
  <span class="hkp__label">
    <span class="hkp__name"><%= choice[:name] %></span>
    <% if choice[:earlier] %><span class="hkp__earlier"><%= choice[:earlier] %></span><% end %>
    <% if choice[:other_repo] %>
      <span class="hkp__warning"><%= sp_icon "warning-fill" %>Hackatime links this to a different repo</span>
    <% end %>
  </span>
  <% if hours %>
    <span class="hkp__hours sp-stat"><span class="sp-stat__key"><%= sp_icon "time-fill" %></span><%= hours %><span class="sp-stat__unit">hrs</span></span>
  <% else %>
    <span class="hkp__note"><%= choice[:note] %></span>
  <% end %>
</label>
