<%# locals: (entries:, id:, highlight: true) %>
<%# D-121: a table of stored jame gam submissions, newest first, a flagged one in coral with its status as a word. `highlight: false` (the other games) shows every status plain. %>
<div class="ap__scroll">
  <table class="ap__table admin__table admin__table--jamegam" id="<%= id %>">
    <thead>
      <tr><th scope="col">Jam</th><th scope="col">Game</th><th scope="col">Status</th><th scope="col">Submitted</th></tr>
    </thead>
    <tbody>
      <% entries.each do |entry| %>
        <% flagged = highlight && JameGam.flagged?(entry["review_status"]) %>
        <tr class="<%= "ap__jame-row--flagged" if flagged %>" data-status="<%= flagged ? "flagged" : "other" %>">
          <th scope="row"><%= entry["jam"].presence || "—" %></th>
          <td><%= entry["game_title"].presence || "Untitled" %></td>
          <td><span class="ap__jame-status<%= " ap__jame-status--flagged" if flagged %>"><%= entry["review_status"].presence || "no status yet" %></span></td>
          <td><%= project_date(Time.iso8601(entry["submitted_at"]).utc.to_date) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
