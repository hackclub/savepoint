{
  "display_information": {
    "name": "Save Point",
    "description": "Keep building your unfinished game. Earn prizes for new hours.",
    "background_color": "#1f2a7a"
  },
  "features": {
    "bot_user": {
      "display_name": "Save Point",
      "always_online": true
    },
    "app_home": {
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "channels:manage",
        "channels:join",
        "groups:write",
        "users:read",
        "emoji:read"
      ],
      "user": [
        "chat:write"
      ]
    }
  },
  "settings": {
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://savepoint.hackclub.com/slack/interactions"
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
