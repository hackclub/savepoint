<%# locals: (project:) %>
<%# D-084: your Hackatime project linked itself (Project#auto_link_hackatime_project) and its time is held until you say it's
    your game (Yes), or pick another. %>
<section class="project__auto-linked" role="status" aria-labelledby="project-auto-linked-title">
  <%= sp_icon "question-fill", "project__auto-linked-icon" %>
  <div class="project__auto-linked-text">
    <h2 class="project__auto-linked-title" id="project-auto-linked-title">
      Is <span class="project__auto-linked-name"><%= project.hackatime_projects.to_sentence %></span> your game?
    </h2>
    <p class="project__auto-linked-note">Its time on Hackatime counts once you say yes.</p>
  </div>
  <div class="project__auto-linked-actions">
    <%= button_to "Yes", project_path, method: :patch, params: { project: { hackatime_auto_linked: false, hackatime_link_confirmed: true } },
          class: "sp-btn sp-btn--gold sp-btn--sm project__step-button" %>
    <%= link_to "Pick another", project_path(step: "hackatime_project"), class: "sp-btn sp-btn--sm project__step-button" %>
  </div>
</section>
