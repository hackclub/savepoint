# Save Point's style sheet lives in design/system (tokens.json, components/bundle.css and bundle.js, fonts). This copies
# it into the app: tokens and fonts as one stylesheet, the components as another, each icon as an SVG for
# LandingHelper#sp_icon, and the colour icons (design/system/icons-color) for LandingHelper#sp_color_icon. Run it after the
# style sheet changes; CI fails if the copies are behind.
namespace :style_sheet do
  desc "Copy the style sheet in design/system into app/assets"
  task :sync do
    require "json"
    require "fileutils"

    source = Rails.root.join("design/system")
    css = Rails.root.join("app/assets/stylesheets/save_point")
    fonts = Rails.root.join("app/assets/fonts/save_point")
    icons = Rails.root.join("app/assets/images/save_point/icons")
    color_icons = Rails.root.join("app/assets/images/save_point/icons-color")
    # The fonts and icon folders are all generated; the stylesheets folder also holds pages' own (landing.css).
    [ fonts, icons, color_icons ].each { |dir| FileUtils.rm_rf(dir) }
    [ css, fonts, icons, color_icons ].each { |dir| FileUtils.mkdir_p(dir) }

    tokens = JSON.parse(source.join("tokens.json").read)
    light, dark = [], []
    %w[color shadow spacing radius size shape].each do |group|
      tokens.dig(group, "tokens").each do |token|
        value = token["value"]
        if value.is_a?(Hash)
          light << "--#{token["name"]}: #{value["light"]};"
          dark << "--#{token["name"]}: #{value["dark"]};"
        else
          light << "--#{token["name"]}: #{value};"
        end
      end
    end
    tokens.dig("type", "families").each { |role, stack| light << "--font-#{role}: #{stack};" }

    faces = tokens.dig("type", "fonts").map do |font|
      FileUtils.cp(source.join(font["file"]), fonts)
      "@font-face { font-family: #{font["family"]}; src: url(\"/save_point/#{File.basename(font["file"])}\") format(\"woff2\"); " \
        "font-weight: #{font["weight"]}; font-style: #{font["style"]}; font-display: swap; }"
    end

    indent = ->(lines, depth) { lines.map { |line| "#{"  " * depth}#{line}" }.join("\n") }
    css.join("tokens.css").write(<<~CSS)
      /* Generated by bin/rails style_sheet:sync from design/system/tokens.json. Do not edit. */
      #{faces.join("\n")}

      :root {
      #{indent.(light, 1)}
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) {
      #{indent.(dark + [ "color-scheme: dark;" ], 2)}
        }
      }
      :root[data-theme="dark"] {
      #{indent.(dark + [ "color-scheme: dark;" ], 1)}
      }
    CSS

    FileUtils.cp(source.join("components/bundle.css"), css.join("components.css"))

    # bundle.js holds the icons as one JSON object of SVG bodies: `var icons = {...};`.
    bodies = JSON.parse(source.join("components/bundle.js").read[/^\s*var icons = (\{.*\});$/, 1])
    bodies.each do |name, body|
      icons.join("#{name}.svg").write(%(<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">#{body}</svg>\n))
    end

    # The colour icons are whole SVGs already (make_color_icons.py), one file each.
    colored = Dir[source.join("icons-color/*.svg")].each { |file| FileUtils.cp(file, color_icons) }

    puts "style sheet: #{light.size} tokens, #{faces.size} fonts, #{bodies.size} icons, #{colored.size} colour icons"
  end
end
