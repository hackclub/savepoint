<%# The free stickers' card (D-051), top of the aside in both of its branches: counting down the first hour, earned and
    waiting to be claimed in the shop, or claimed. Nothing for accounts that can't earn them (sticker_promise_state). %>
<% state = sticker_promise_state(current_user) %>
<% if state %>
  <% minutes = Reward::STICKERS_SECONDS / 60 %>
  <section class="sticker-promise" data-state="<%= state[:kind] %>" aria-labelledby="sticker-promise-title">
    <span class="sticker-promise__art" aria-hidden="true"><%= image_tag "sticker-promise.svg", alt: "", width: 335, height: 432 %></span>
    <% case state[:kind] %>
    <% when :counting %>
      <h2 class="sticker-promise__title" id="sticker-promise-title">Free stickers</h2>
      <p class="sticker-promise__about">
        Work on your game for <b><%= minutes %> minutes</b> before
        <b data-controller="local-time" data-local-time-at-value="<%= state[:deadline].iso8601 %>" data-local-time-time-only-value="true"><%= state[:deadline].utc.strftime("%-l:%M %P") %> UTC</b>.
      </p>
      <div class="sticker-promise__panel">
        <p class="sticker-promise__clock" role="timer" aria-label="Time left" data-controller="countdown" data-countdown-ends-at-value="<%= state[:deadline].iso8601 %>">
          <b data-countdown-target="part" data-part="m">00</b><span aria-hidden="true">:</span><b data-countdown-target="part" data-part="s">00</b>
          <small>left</small>
        </p>
        <% if state[:tracking] %>
          <% if state[:seconds] %>
            <div class="sticker-promise__progress" role="progressbar" aria-valuemin="0" aria-valuemax="<%= minutes %>" aria-valuenow="<%= state[:minutes] %>" aria-label="Minutes on your game">
              <span class="sticker-promise__fill" style="width: <%= state[:percent] %>%"></span>
            </div>
            <p class="sticker-promise__count"><%= sticker_progress_text(state) %></p>
          <% end %>
        <% else %>
          <p class="sticker-promise__count">Only minutes on your linked game count. <%= link_to "Link your Hackatime project", project_path(step: "hackatime_project") %> to get started.</p>
        <% end %>
      </div>
    <% when :earned %>
      <h2 class="sticker-promise__title" id="sticker-promise-title">Stickers are yours!</h2>
      <p class="sticker-promise__about">You worked on your game in your first hour. Tell us where to send them.</p>
      <%= link_to shop_path(claim: "stickers"), class: "sp-btn sp-btn--gold sticker-promise__action" do %><%= sp_icon "gift-fill" %>Claim your stickers<% end %>
    <% when :claimed %>
      <h2 class="sticker-promise__title" id="sticker-promise-title">Stickers claimed</h2>
      <p class="sticker-promise__about">They're on their way once Hack Club sends them. We'll message you when they're ordered.</p>
    <% end %>
  </section>
<% end %>
