# Sign-in with Hack Club Auth and linking Hackatime. Credentials (hack_club_auth:, hackatime:) win if set.
HACK_CLUB_AUTH_CLIENT_ID=
HACK_CLUB_AUTH_CLIENT_SECRET=
HACKATIME_CLIENT_ID=
HACKATIME_CLIENT_SECRET=
# Set to 1 to send sign-in on to Hackatime's OAuth (D-026). Leave empty until the Hackatime app works.
HACKATIME_CHAIN=
# Production only: this site's address, for the Hack Club Auth callback.
APP_URL=https://savepoint.hackclub.com

# Slack bot token (the "Save Point" app, xoxb-…). Credentials slack.bot_token is the fallback.
SLACK_BOT_TOKEN=
# 1 puts a GIF on each participant DM (SlackGifs, config/slack_gifs.yml). Leave empty in production for now (D-036).
SLACK_GIFS=
# User OAuth Token (xoxp-...) for bin/rails slack:announce. Posts as Armand. Local .env only.
SLACK_USER_TOKEN=

# GitHub App for the GitHub API (raises the rate limit from 60 an hour). Settings: https://github.com/settings/apps (the Save Point app).
# Private key as PEM text (\n escapes allowed) or a file path. GITHUB_TOKEN (a personal access token) is the fallback.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_TOKEN=

# Admins: Slack user IDs (comma or whitespace separated) who can open /admin, review ships and get admin DMs.
# Merged with credentials admin_slack_ids. Needed in production, which has no credentials file.
ADMIN_SLACK_IDS=

# Airtable (D-027). Program token: read and write on the Save Point base, plus schema.bases:read and :write for bin/rails airtable:provision. Credentials airtable.program_token is the fallback.
AIRTABLE_PROGRAM_TOKEN=
# Read-only token (data.records:read) for the Unified YSWS DB, to catch a game another YSWS paid for. Credentials airtable.unified_token is the fallback.
AIRTABLE_UNIFIED_TOKEN=
# Read-only token (data.records:read) for the jame gam base (D-066): a game submitted there only counts time after the submission. Credentials airtable.jamegam_token is the fallback.
JAMEGAM_AIRTABLE_TOKEN=
# Set to 1 to copy Postgres rows to Airtable every minute. Leave empty until bin/rails airtable:provision has run.
AIRTABLE_SYNC=

# Cloudflare R2 for screenshots in production (config/storage.yml). Without R2_BUCKET and R2_ACCESS_KEY_ID they stay on the container disk.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
