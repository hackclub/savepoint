<% content_for :title, "Shop · Save Point" %>
<% content_for :stylesheets, " save_point/prize_tag save_point/pages/shop" %>
<%# Without a project it's the public shop: anyone can browse. %>
<% public = @project.nil? %>
<%# Your goal comes first, with the rest in their order. The public shop has none. %>
<% shelf = shop_shelf(@project).each_with_index.map { |card, rank| card.merge(rank:) }.partition { |card| card[:goal] }.flatten(1) %>
<% ship_status, ship_tone = shop_ship_status(@project) unless public %>

<%# The shop: every prize in Prize::ALL, fewest hours first, as the cards onboarding's prize step draws (the same tiers: up to
    a third of the prizes by hours is green, the middle third blue, the dearest purple). The one you're aiming for is
    gold. Under your hours are the cards. A card you
    can pay for has a Claim button (it opens the prize's sheet at the claim step), one you can't says how many more hours it takes, and one
    you've claimed says where it is. Everything's in hours. %>
<div class="pg-shop sp-page">
  <%= render "shared/top_bar", current: :shop %>

  <main class="pg-shop__main">
    <div class="shop">
      <div class="pg-shop__head">
        <h1 class="shop__title"><%= sp_color_icon "shopping-bag-1-fill", "shop__title-icon" %><span class="shop__title-text">Shop</span></h1>
        <div class="pg-shop__stats">
          <% unless public %>
            <div class="shop__stat shop__stat--logged">
              <span class="shop__stat-key" aria-hidden="true"><%= sp_icon "time-fill" %></span>
              <span class="shop__stat-label">LOGGED</span>
              <span class="shop__stat-value" data-tone="done"><%= shop_hours(@project.hours_logged) %></span>
            </div>
            <div class="shop__stat shop__stat--ship">
              <span class="shop__stat-key shop__stat-key--coin" aria-hidden="true"><%= hours_coin %></span>
              <span class="shop__stat-label">TO SPEND</span>
              <span class="shop__stat-value" data-tone="<%= ship_tone %>"><%= ship_status %></span>
            </div>
          <% end %>
        </div>
      </div>

      <%# What the claim said, after the page it redirected to (OrdersController): a claimed prize, or why the claim failed (the claim
          sheet shows its own problems with JavaScript on). A plain line near the top, and the card it is about is marked below. %>
      <% claimed = Prize.find(flash[:shop_claimed]) if flash[:shop_claimed].present? %>
      <% if claimed %>
        <p class="sp-toast shop__notice" role="status"><span class="sp-toast__icon" aria-hidden="true"><%= sp_icon "check-fill" %></span><span>You claimed the <%= claimed.name %>. We'll order it soon.</span></p>
      <% elsif flash[:shop_error].present? %>
        <p class="sp-toast sp-toast--coral shop__notice" role="alert"><span class="sp-toast__icon" aria-hidden="true"><%= sp_icon "warning-fill" %></span><span><%= flash[:shop_error] %></span></p>
      <% end %>

      <%# The free stickers (D-051), for someone who earned them and has not claimed them yet. They are not in the grid below. %>
      <%= render "shop/sticker_claim", open: @open_sticker_claim if shop_sticker_claim?(@project) %>

      <%# The tags are the landing page's (shared/_prize_tag, drawn by _shop_shapes). What you can do with one sits under it. %>
      <%= render "pages/landing/shop_shapes" %>
      <ul class="shop__grid" aria-label="Prizes">
        <% shelf.each do |card| %>
          <% prize = card[:prize] %>
          <li class="shop-tag shop-prize<%= " shop-prize--goal" if card[:goal] %><%= " shop-prize--just-claimed" if claimed == prize %>" id="shop-<%= prize.key %>" data-rank="<%= card[:rank] %>" data-state="<%= card[:state] %>"
              data-controller="prize-sheet" data-prize-sheet-open-sound-value="<%= audio_path("save_point/claim.mp3") %>"
              data-prize-sheet-confirm-sound-value="<%= audio_path("save_point/confirm.mp3") %>">
            <%# The whole tag opens that prize's sheet: its details, and for a prize you can pay for the claim step. %>
            <button type="button" data-controller="tag-swing" data-action="prize-sheet#open" aria-haspopup="dialog" aria-label="<%= prize.name %>, details"
                    class="shop-card shop-card--<%= prize_tier(prize) %><%= " is-goal" if card[:goal] %><%= " is-claimed" if card[:state] == "claimed" %>">
              <%= render "shared/prize_tag", prize: %>
            </button>
            <% case card[:state] %>
            <% when "ready" %>
              <%# A shortcut to the sheet's claim step. Without JavaScript it claims at once, with the name and address as they are. %>
              <%= button_to shop_order_path, params: { order: { prize_key: prize.key } }, class: "sp-btn sp-btn--gold sp-btn--sm shop-tag__action",
                    form: { data: { turbo: false, action: "submit->prize-sheet#claim" } } do %><%= sp_icon "gift-fill" %>Claim<% end %>
            <% when "claimed", "locked" %>
              <span class="shop-tag__status shop-prize__status" data-state="<%= card[:state] %>">
                <% if card[:state] == "claimed" %><%= sp_icon "check-circle-fill" %><% end %><%= shop_card_status(card) %>
              </span>
            <% end %>
            <%= render "shop/prize_sheet", card:, public: %>
          </li>
        <% end %>
      </ul>
      <%= render "shop/unavailable_note", klass: "shop__note" %>
    </div>
  </main>
</div>
