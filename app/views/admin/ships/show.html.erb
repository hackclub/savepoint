<% content_for :title, "#{@ship.title} · Ships · Save Point admin" %>
<% content_for :stylesheets, " save_point/pages/admin-ship" %>
<% project = @ship.project %>
<% user = project.user %>
<% tone = { "approved" => "mint", "rejected" => "coral", "changes_needed" => "coral" }.fetch(@ship.status, "gold") %>
<% status_icon = { "approved" => "check-circle-fill", "rejected" => "close-circle-fill", "changes_needed" => "refresh-2-fill", "awaiting_fraud" => "search-fill", "superseded" => "refresh-2-fill" }.fetch(@ship.status, "time-fill") %>
<% own = @ship.by?(current_user) %>

<%# One ship in full (D-002, D-106). What a reviewer reads on every review is open: who, the hours on one line, a problem line
    only when one applies, what they changed, the screenshots, the commits. What is read now and then (the README, the
    repository, the participant, Lapse, the hours start, the snapshot editor) sits in a closed section with one fact in its
    summary. One level of disclosure, no nesting. The decision rail, whose top is the one hours panel (claimed, counted, the cuts, the most to approve), sits beside it from 1200px (D-070). Real names and emails
    are here, so nothing on this page is recorded. Styled in admin-ship.css. %>
<div class="sp-page pg-admin-ship" data-controller="shortcuts">
  <div class="ash">
    <main class="ash__main">
      <header class="ash__head">
        <p class="ash__back"><%= link_to admin_ships_path do %><%= sp_icon "left-fill" %>All ships<% end %></p>
        <h1 class="ash__title"><%= @ship.title %></h1>
        <p class="ash__status">
          <span class="sp-badge sp-badge--<%= tone %>" data-decision="<%= @ship.status %>"><%= sp_icon status_icon %><%= ship_status_label(@ship) %></span>
          <% unless @ship.in_review? %><small class="admin__muted"><%= (@ship.decided_by || @ship.reviewer)&.first_name.presence || "someone" %> · <%= (@ship.decided_at || @ship.reviewed_at || @ship.updated_at).strftime("%b %-d") %></small><% end %>
        </p>
        <p class="leaderboard__note ash__byline">
          Shipped <%= @ship.created_at.strftime("%b %-d, %H:%M") %> UTC by
          <%= admin_avatar_link(user, "admin__avatar") %><%= admin_person_link(user) %><% if user.slack_display_name.present? %>
          (<%= name_with_slack(user, name: user.slack_display_name) %> on Slack)<% end %>.
        </p>
        <p class="ash__links">
          <%# A link that isn't http(s) shows as text, never as a link (the reviewer still sees what was typed). %>
          <% { "repo" => [ @ship.repo_url, "github-fill", "Repo" ], "demo" => [ @ship.demo_url, "play-fill", "Demo" ] }.each do |key, (url, icon, name)| %>
            <% if safe_http_url?(url) %>
              <%= link_to url.to_s.strip, target: "_blank", rel: "noopener", class: "sp-btn sp-btn--sm ash__link-btn", id: "admin-ship-#{key}-link" do %><%= sp_icon icon %><%= name %><% end %>
            <% else %>
              <span class="admin__muted ash__unsafe-link"><%= url %></span>
            <% end %>
          <% end %>
          <%= link_to @evidence.telescreen_url, target: "_blank", rel: "noopener", class: "sp-btn sp-btn--sm ash__link-btn", id: "admin-ship-telescreen" do %><%= sp_icon "search-fill" %>Telescreen<% end %>
          <%= link_to @evidence.lapse_review_url, target: "_blank", rel: "noopener", class: "sp-btn sp-btn--sm ash__link-btn", id: "admin-ship-lapse-review" do %><%= sp_icon "play-fill" %>Lapse review<% end %>
          <% if @ship.pending? && !own %>
            <%# D-063: the queue's skip, to the next ship waiting for this stage. %>
            <%= link_to "Skip", (@ship.in_review? ? admin_review_path(skip: @ship.id) : admin_fraud_path(skip: @ship.id)), class: "sp-btn sp-btn--sm ash__skip", data: { shortcut: "n" } %>
            <kbd class="ash__kbd">n</kbd>
          <% end %>
        </p>
        <% if flash[:alert] %>
          <p class="sp-toast sp-toast--coral ash__alert" role="alert">
            <span class="sp-toast__icon"><%= sp_icon "warning-fill" %></span><%= flash[:alert] %>
          </p>
        <% end %>
        <% if flash[:notice] %>
          <p class="sp-toast ash__alert" role="status"><span class="sp-toast__icon"><%= sp_icon "check-fill" %></span><%= flash[:notice] %></p>
        <% end %>
        <%= render "admin/ships/claim", ship: @ship, claim: @claim, held: @held %>
        <% if @ship.superseded? %>
          <%# D-109: the participant shipped again before this one was reviewed. Their newer ship is the one to judge. %>
          <p class="ash__problem" data-replaced="true"><%= sp_icon "refresh-2-fill" %>The participant shipped again, so this ship was replaced.
            <% if @ship.superseded_by %><%= link_to "See the newer ship", admin_ship_path(@ship.superseded_by) %><% end %></p>
        <% elsif @ship.in_review? && (earlier = @ship.waiting_on_earlier) %>
          <p class="ash__problem" data-waiting-on-earlier="true"><%= sp_icon "time-fill" %>An earlier ship of this project is still in its fraud check. Judge this one after it.
            <%= link_to "See the earlier ship", admin_ship_path(earlier) %></p>
        <% end %>
        <% if own && @ship.pending? %>
          <p class="ash__problem" data-own="true"><%= sp_icon "lock-fill" %>This is your own ship. Someone else judges it.</p>
        <% end %>
      </header>

      <div class="ash__layout">
      <div class="ash__col">
      <% problems = render("admin/ships/problems", ship: @ship, evidence: @evidence, limits: @limits, earlier_ship: @earlier_ship) %>
      <% if problems.present? %><div class="ash__problems"><%= problems %></div><% end %>

      <section class="sp-panel ash__panel ash__statement" aria-labelledby="admin-ship-statement">
        <h2 class="sp-ribbon ash__ribbon" id="admin-ship-statement"><span><%= sp_icon "edit-2-fill" %>What they changed</span></h2>
        <% if @ship.changes_made.present? %>
          <p class="ash__description ash__statement-text"><%= @ship.changes_made %></p>
        <% else %>
          <p class="admin__muted">This ship was sent before the question existed.</p>
        <% end %>
        <% if @ship.description.present? %>
          <h3 class="sp-label ash__sub">Description</h3>
          <p class="ash__description admin__ship-description"><%= @ship.description %></p>
        <% end %>
      </section>

      <%= render "admin/ships/screenshots", ship: @ship, earlier_ship: @earlier_ship, earlier_approval: @earlier_approval %>

      <section class="sp-panel ash__panel ash__commits" aria-labelledby="admin-ship-commits">
        <h2 class="sp-ribbon ash__ribbon" id="admin-ship-commits"><span><%= sp_icon "github-fill" %><%= @earlier_approval && !@all_commits ? "Commits since the last approved ship" : "Commits since Save Point began" %></span></h2>
        <% from = @earlier_approval && !@all_commits ? @earlier_approval.ship.created_at : project.hours_start %>
        <% if @listed_commits.ok? && @listed_commits.commits.any? %>
          <p class="admin__muted ash__commits-note">
            <%= @listed_commits.commits.size %><%= "+" if @listed_commits.more %> from <%= from.utc.strftime("%b %-d") %> to <%= @ship.created_at.utc.strftime("%b %-d, %H:%M") %> UTC.
            <% if @earlier_approval %>
              <% if @all_commits %>
                <%= link_to "Show only since the last approved ship", admin_ship_path(@ship, queue: params[:queue].presence), id: "admin-ship-commits-toggle" %>
              <% else %>
                <%= link_to "Show all commits since #{project.hours_start.utc.strftime("%b %-d")}", admin_ship_path(@ship, queue: params[:queue].presence, commits: "all"), id: "admin-ship-commits-toggle" %>
              <% end %>
            <% end %>
          </p>
          <ol class="ash__commit-list">
            <% @listed_commits.commits.each do |commit| %>
              <li class="ash__commit">
                <%= link_to commit.sha, commit.url, target: "_blank", rel: "noopener", class: "ash__sha" %>
                <span class="ash__commit-message"><%= commit.message.presence || "(no message)" %></span>
                <small class="admin__muted"><%= commit.author %> · <%= commit.date.utc.strftime("%b %-d, %H:%M") %></small>
              </li>
            <% end %>
          </ol>
        <% elsif @commits.ok? %>
          <p class="ash__problem" data-commits="none"><%= sp_icon "warning-fill" %><%= @earlier_approval && !@all_commits ? "No commits between the last approved ship and this one." : "No commits between Save Point's start and the ship." %></p>
          <% if @earlier_approval && !@all_commits && @commits.commits.any? %>
            <p class="admin__muted"><%= link_to "Show all commits since #{project.hours_start.utc.strftime("%b %-d")}", admin_ship_path(@ship, queue: params[:queue].presence, commits: "all"), id: "admin-ship-commits-toggle" %></p>
          <% end %>
        <% else %>
          <p class="ash__problem" data-commits="<%= @commits.status %>"><%= sp_icon "warning-fill" %><%= @commits.message %></p>
        <% end %>
      </section>

      <%# Closed, one fact each: read when the open parts raise a question. %>
      <%= render "admin/ships/readme", readme: @readme, ship: @ship %>
      <%= render "admin/ships/evidence", evidence: @evidence, limits: @limits, others: @others %>
      <%= render "admin/ships/hours_start", ship: @ship %>
      <%= render "admin/ships/snapshot_edit", snapshot: @snapshot, ship: @ship %>
      </div>

        <aside class="ash__rail" aria-label="Checklist and decision">
        <%# D-049: the reviewer's checklist, saved on every tick (Admin::ShipsController#checklist). It sits closed in the decision
            panel, with how many are ticked in its summary, and never blocks a verdict. %>
        <% checklist = { "runs" => "The game runs from the demo link",
                         "readme" => "The README says how to run it", "screenshot" => "The screenshot shows the game running",
                         "hours_fit" => "The hours fit the scope of the changes", "art_cap" => "The art time is within the #{Ship::Limits::ART_CAP_PERCENT}% cap",
                         "not_double" => "The hours aren't already approved in another program" } %>
        <% defaults = @ship.checklist_defaults(earlier: @earlier_ship, limits: @limits) %>
        <% ticked = checklist.keys.count { |key| @ship.checklist_tick(key, defaults) } %>
        <section class="sp-panel ash__panel ash__decide ash__decide--<%= tone %>" aria-labelledby="admin-ship-decision">
          <h2 class="sp-ribbon <%= "sp-ribbon--gold" if @ship.pending? %> ash__ribbon" id="admin-ship-decision"><span><%= sp_icon "flag-1-fill" %><%= @ship.awaiting_fraud? ? "Fraud check" : "Decision" %></span></h2>
          <%# D-063: three states. Waiting for a review, the verdict form. Waiting for its fraud check, the fraud form. Decided, what
              was decided. Your own ship has no form: someone else judges it. %>
          <%= render "admin/ships/hours", ship: @ship, project:, evidence: @evidence, limits: @limits %>
          <% if @ship.in_review? && !own %>
            <%= render "admin/ships/verdict", ship: @ship, limits: @limits, earlier_ship: @earlier_ship, send_backs: @send_backs,
                       checklist:, defaults:, ticked: %>
          <% elsif @ship.awaiting_fraud? && !own %>
            <%= render "admin/ships/checklist", ship: @ship, checklist:, defaults:, ticked:, own: %>
            <%= render "admin/ships/fraud", ship: @ship %>
          <% elsif @ship.pending? %>
            <p class="leaderboard__note ash__note">Waiting for <%= @ship.in_review? ? "a review" : "its fraud check" %> by someone else.</p>
            <%= render "admin/ships/checklist", ship: @ship, checklist:, defaults:, ticked:, own: %>
          <% else %>
            <%= render "admin/ships/decided", ship: @ship, earlier_ship: @earlier_ship, status_icon: %>
            <%= render "admin/ships/checklist", ship: @ship, checklist:, defaults:, ticked:, own: %>
          <% end %>
        </section>
        </aside>
      </div>

      <%= render "admin/ships/send_backs", send_backs: @send_backs %>
    </main>
  </div>
</div>
