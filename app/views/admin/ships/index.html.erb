<% content_for :title, "Ships · Save Point admin" %>
<% content_for :stylesheets, " save_point/pages/admin-ships" %>
<% shipped_hours = Ship.latest_per_project.sum(:hours) %>
<% waiting = @counts["in_review"] + @counts["awaiting_fraud"] %>

<%# Every ship: the ones waiting for a review, then for their fraud check (oldest first), then the ones decided. A tab per
    stage, with its count, narrows it to one (D-063). Each opens in full. Real names and emails are here, so nothing on this
    page is recorded. Styled in admin-ships.css; the rows are the shared admin/ships/_row. %>
<div class="sp-page pg-admin-ships">
  <main class="pg-admin-ships__wrap pg-admin-ships__main">
    <header class="pg-admin-ships__head">
      <div class="pg-admin-ships__title-row">
        <h1 class="pg-admin-ships__title">What's been shipped</h1>
        <span class="sp-stat pg-admin-ships__stat" data-waiting="<%= waiting.positive? %>">
          <span class="sp-stat__key"><%= sp_icon "rocket-fill" %></span>
          <span class="pg-admin-ships__queue"><%= waiting %> waiting</span>
        </span>
      </div>
      <p class="pg-admin-ships__note">
        Open a ship to see it in full, screenshot and all, and to review it. A review's approval goes to a fraud check, and
        only a pass gives them hours to spend. Hours are as they were when it was shipped.
        <%= project_hours(shipped_hours) %> hrs across every project that's shipped.
      </p>
      <% if flash[:alert] %>
        <p class="pg-admin-ships__alert" role="alert"><%= sp_icon "warning-fill" %><span><%= flash[:alert] %></span></p>
      <% end %>
      <div class="pg-admin-ships__start">
        <%= link_to admin_review_path, class: "sp-btn sp-btn--gold sp-btn--sm" do %><%= sp_icon "play-fill" %>Review the oldest<% end %>
        <%= link_to admin_fraud_path, class: "sp-btn sp-btn--sm" do %><%= sp_icon "search-fill" %>Fraud-check the oldest<% end %>
      </div>
      <nav class="pg-admin-ships__tabs" aria-label="Stages">
        <%= link_to admin_ships_path, class: "pg-admin-ships__tab", aria: { current: ("page" unless @stage) } do %>All <b><%= @counts.values.sum %></b><% end %>
        <% Ship::STAGES.each do |key, label| %>
          <%= link_to admin_ships_path(stage: key), class: "pg-admin-ships__tab", data: { stage: key }, aria: { current: ("page" if @stage == key) } do %><%= label.capitalize %> <b><%= @counts[key] %></b><% end %>
        <% end %>
      </nav>
    </header>

    <% sections = [ [ "In review", "admin-ships-review", @in_review, "Nothing's waiting.", "time-fill", "in_review" ],
                    [ "Fraud check", "admin-ships-fraud", @awaiting_fraud, "No fraud checks waiting.", "search-fill", "awaiting_fraud" ],
                    [ "Decided", "admin-ships-decided", @decided, "None yet.", "check-circle-fill", nil ] ] %>
    <% sections.each do |heading, id, ships, empty, icon, stage| %>
      <% next if @stage && (stage ? stage != @stage : @stage.in?(%w[in_review awaiting_fraud])) %>
      <section class="pg-admin-ships__section" aria-labelledby="<%= id %>">
        <div class="pg-admin-ships__section-head">
          <h2 class="pg-admin-ships__heading" id="<%= id %>"><%= sp_icon icon, "pg-admin-ships__heading-icon" %><%= heading %></h2>
          <span class="pg-admin-ships__count"><%= ships.size %></span>
        </div>
        <% if ships.empty? %>
          <div class="pg-admin-ships__empty">
            <%= sp_icon icon, "pg-admin-ships__empty-icon" %>
            <p><%= empty %></p>
          </div>
        <% else %>
          <div class="pg-admin-ships__panel">
            <table class="pg-admin-ships__table">
              <thead>
                <tr>
                  <th scope="col">Who</th>
                  <th scope="col">Ship</th>
                  <th class="pg-admin-ships__num" scope="col">Hours</th>
                  <th scope="col">Shipped</th>
                  <th scope="col">Status</th>
                </tr>
              </thead>
              <tbody>
                <% ships.each do |ship| %>
                  <%= render "admin/ships/row", ship: %>
                <% end %>
              </tbody>
            </table>
          </div>
        <% end %>
      </section>
    <% end %>
  </main>
</div>
