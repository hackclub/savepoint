<%# locals: (ship:, earlier_ship:, status_icon:) %>
<%# What was decided, once the ship is: the verdict and who made it, the hours split, the reviewer's two notes, the fraud check,
    and (approved) what goes to Airtable. %>
<% format = Ship::Limits.method(:format) %>
<% prior = ship.earlier_approval %>
<div class="ash__verdict">
  <span class="ash__verdict-icon"><%= sp_icon status_icon %></span>
  <p class="leaderboard__note ash__verdict-text" data-decision="<%= ship.status %>">
    <%= ship_decision(ship) %><% if ship.approved? %>, with <%= project_hours(ship.approved_hours || ship.hours) %> hrs to spend<% end %>.
  </p>
</div>
<% if ship.review_hours %>
  <dl class="ash__limits" id="admin-ship-review-hours">
    <div><dt><%= prior ? "Review approved, total" : "Review approved" %> <small>by <%= ship.reviewer&.first_name.presence || "someone" %></small></dt><dd><%= format.(ship.review_hours) %> hrs</dd></div>
    <% if prior && ship.approved? && ship.approved_hours %>
      <div id="admin-ship-decided-already"><dt>Already approved <small><%= prior.on.strftime("%b %-d") %> ship</small></dt><dd><%= format.(prior.hours) %> hrs</dd></div>
      <div id="admin-ship-decided-new"><dt>New hours approved</dt><dd><%= format.([ ship.approved_hours - prior.hours, 0 ].max) %> hrs</dd></div>
    <% end %>
    <% if ship.review_coding_hours %>
      <div><dt>Coding</dt><dd><%= format.(ship.review_coding_hours) %> hrs</dd></div>
      <div><dt>Art</dt><dd><%= format.(ship.review_art_hours.to_d) %> hrs</dd></div>
    <% end %>
    <% if ship.fraud_deduction_hours.positive? %><div><dt>Fraud deduction</dt><dd><small>−<%= format.(ship.fraud_deduction_hours) %></small></dd></div><% end %>
  </dl>
<% end %>
<% if ship.fraud_status.present? %>
  <p class="sp-label ash__justify-label">Fraud check</p>
  <p class="ash__description" id="admin-ship-fraud" data-fraud="<%= ship.fraud_status %>">
    <%= { "passed" => "Passed", "deducted" => "Passed with a deduction", "banned" => "Banned" }.fetch(ship.fraud_status) %>
    by <%= ship.fraud_reviewer&.first_name.presence || "someone" %>.<%= " #{ship.fraud_notes}" if ship.fraud_notes.present? %>
  </p>
<% end %>
<% if ship.reviewer_ai_coding_hours %>
  <p class="sp-label ash__justify-label">AI coding raised</p>
  <p class="ash__description" id="admin-ship-ai-raised"><%= format.(ship.reviewer_ai_coding_hours) %> hrs, above Hackatime's <%= format.(ship.ai_coding_seconds.to_i.to_d / 3600) %> hrs. <%= ship.reviewer_ai_reason %></p>
<% end %>
<% if ship.technical_features.present? %>
  <p class="sp-label ash__justify-label">Specific technical features</p>
  <p class="ash__description" id="admin-ship-features"><%= ship.technical_features %></p>
<% end %>
<% if ship.review_judgement.present? %>
  <p class="sp-label ash__justify-label">Judgement</p>
  <p class="ash__description" id="admin-ship-judgement"><%= ship.review_judgement %></p>
<% end %>
<% if ship.review_feedback.present? %>
  <p class="sp-label ash__justify-label">Note to the participant</p>
  <p class="ash__description" id="admin-ship-feedback"><%= ship.review_feedback %></p>
<% end %>
<% if ship.approved? %>
  <%# What the sync sends to the handbook's justification fields (AirtableFields.justifications). D-111: a deflation with a part
      that has no reason isn't sent at all (the sync raises), so the page says so instead of drawing its text. %>
  <% fields = (AirtableFields.justifications(ship, earlier: earlier_ship, strict: false) if earlier_ship.checked?) %>
  <% problem = AirtableFields.deflation_problem(ship) %>
  <p class="sp-label ash__justify-label">For Airtable</p>
  <% if problem %><p class="ash__problem" id="admin-ship-deflation-problem" role="alert"><%= sp_icon "warning-fill" %>Not sent to Airtable: <%= problem %>. Every deflation needs a reason.</p><% end %>
  <dl class="ash__justify" id="admin-ship-airtable">
    <% if fields %>
      <% fields.each do |name, value| %>
        <div><dt><%= name.delete_prefix("Justification - ").delete_prefix("Optional - Override ") %></dt><dd><%= value %></dd></div>
      <% end %>
    <% else %>
      <div><dt>For Airtable</dt><dd><%= earlier_ship.message %> The sync waits until it can check.</dd></div>
    <% end %>
  </dl>
<% end %>
<%# D-150: until the Unified YSWS DB takes the row, an admin can fix the text the reviewer wrote. The ship is sent again with it. %>
<% if ship.review_text_open? && !ship.by?(current_user) %>
  <details class="ash__disc" id="admin-ship-review-text">
    <summary class="ash__disc-sum"><span class="ash__disc-title"><%= sp_icon "edit-2-fill" %>Fix the review text</span></summary>
    <div class="ash__disc-body">
      <p class="admin__muted">Changes the text only, not the hours. It goes to Airtable with the ship's first Unified send.</p>
      <%= form_with model: ship, scope: :ship, url: review_text_admin_ship_path(ship), method: :patch, data: { turbo: false } do |form| %>
        <div class="sp-field"><%= form.label :technical_features, "Specific technical features", class: "sp-label" %>
          <%= form.text_area :technical_features, rows: 4, class: "sp-input ash__textarea" %></div>
        <div class="sp-field"><%= form.label :review_judgement, "Judgement", class: "sp-label" %>
          <%= form.text_area :review_judgement, rows: 4, class: "sp-input ash__textarea" %></div>
        <div class="sp-field"><%= form.label :deflation_reason, "Why the hours are below what the rules allow", class: "sp-label" %>
          <%= form.text_area :deflation_reason, rows: 3, class: "sp-input ash__textarea" %></div>
        <%= form.button type: "submit", class: "sp-btn sp-btn--royal" do %><%= sp_icon "save-2-fill" %>Save review text<% end %>
      <% end %>
    </div>
  </details>
<% elsif ship.approved? && ship.in_unified? %>
  <p class="admin__muted" id="admin-ship-review-text-locked"><%= Ship::IN_UNIFIED_MESSAGE %></p>
<% end %>
