<%# locals: (choices:, type: "checkbox", name: nil, input_data: {}, selected: nil, label: "Your Hackatime projects", limit: 8) %>
<%# The Hackatime projects you can pick, always open: a row for each, with a coin that is ticked when the project is
    linked, the project's name and its hours. Rows are pills, and everything inside one sits 6px from its edge (the hours
    pill's 3px lip counts), so the coin, the hours pill and the gold coin in it are concentric (hackatime_picker.css).
    D-089: it lists every project you have. Past `limit` rows the rest wait behind "Show older projects" (a linked or picked one
    always shows), so a long history stays usable.
    selected: the one name that's picked (radios), else each choice's own linked flag. A checkbox has no name: the
    picker sends the ticked ones itself (hackatime_picker_controller.js), so a form around it never carries them. %>
<% shown, older = choices.each_with_index.partition { |choice, index| index < limit || choice[:linked] || selected == choice[:name] }.map { |part| part.map(&:first) } %>
<div class="hkp__list" role="<%= type == "radio" ? "radiogroup" : "group" %>" aria-label="<%= label %>">
  <% shown.each do |choice| %>
    <%= render "shared/hackatime_row", choice:, type:, name:, input_data:, selected: %>
  <% end %>
  <% if older.any? %>
    <details class="hkp__older">
      <summary class="hkp__more sp-btn sp-btn--ghost sp-btn--sm">Show <%= older.size == 1 ? "1 older project" : "#{older.size} older projects" %></summary>
      <div class="hkp__list">
        <% older.each do |choice| %>
          <%= render "shared/hackatime_row", choice:, type:, name:, input_data:, selected: %>
        <% end %>
      </div>
    </details>
  <% end %>
</div>
