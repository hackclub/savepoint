<%# locals: (open: false) %>
<%# The free stickers' claim card (D-051): above the shop's grid, only for someone who earned them and has no sticker order yet
    (shop_sticker_claim?). It is the claim flow every prize uses: its button opens a sheet whose second step is the shared claim
    step (name and address), and the claim becomes a zero-hour Order that waits on /admin/orders like any other. %>
<% prize = Prize::STICKERS %>
<section class="sticker-claim" id="shop-stickers" aria-labelledby="sticker-claim-title"
         data-controller="prize-sheet" data-prize-sheet-start-value="claim" data-prize-sheet-auto-open-value="<%= open %>"
         data-prize-sheet-open-sound-value="<%= audio_path("save_point/claim.mp3") %>"
         data-prize-sheet-confirm-sound-value="<%= audio_path("save_point/confirm.mp3") %>">
  <span class="sticker-claim__art" aria-hidden="true"><%= image_tag "sticker-promise.svg", alt: "", width: 335, height: 432 %></span>
  <div class="sticker-claim__text">
    <h2 class="sticker-claim__title" id="sticker-claim-title">Your free stickers are ready</h2>
    <p class="sticker-claim__about">You worked on your game in your first hour. Tell us where to send them.</p>
  </div>
  <%# Without JavaScript this claims at once, with the name and address as they are. %>
  <%= button_to shop_order_path, params: { order: { prize_key: prize.key } }, class: "sp-btn sp-btn--gold sticker-claim__action",
        form: { class: "sticker-claim__form", data: { turbo: false, action: "submit->prize-sheet#claim" } } do %><%= sp_icon "gift-fill" %>Claim your stickers<% end %>

  <dialog class="order-sheet order-sheet--stickers" aria-labelledby="sheet-stickers-title" data-prize-sheet-target="dialog" data-action="click->prize-sheet#closeOutside close->prize-sheet#reset">
    <div class="order-sheet__card shop-card--rare">
      <div class="order-sheet__top">
        <div class="order-sheet__head">
          <h2 class="order-sheet__name" id="sheet-stickers-title"><%= prize.name %></h2>
          <p class="order-sheet__kind"><%= prize.kind %></p>
        </div>
        <div class="order-sheet__art"><span class="order-sheet__rays" aria-hidden="true"></span><%= image_tag "sticker-promise.svg", alt: "" %></div>
        <svg class="order-sheet__wave" viewBox="0 0 400 48" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M0 30 C 70 6, 130 4, 200 22 S 330 48, 400 14 V 48 H 0 Z"/></svg>
      </div>

      <%# No preview step (facts and "Claim it") here: the sheet opens on the form, and its first button closes it. %>
      <%= render "shop/claim_step", prize:, left: 0, free: true, closes: true %>
    </div>
  </dialog>
</section>
