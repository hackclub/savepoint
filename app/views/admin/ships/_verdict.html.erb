<%# locals: (ship:, limits:, earlier_ship:, send_backs:, checklist:, defaults:, ticked:) %>
<%# D-063: the review's verdict, as playground has it. Coding hours and art hours apart, each with presets at 15, 30, 50 and 75%
    of what was claimed (deflate_controller.js), a live total, and the handbook's limits already applied: AI coding counts at
    a third, art at most 30% of the total (Ship::Limits, D-030). "Why deflated" shows whenever hours are cut and is due only below
    those limits (D-112). One form, four verdicts (D-106): the four buttons come first, picking one shows its fields and a submit
    button named for the action, and its key pressed again submits (verdict_controller.js, shortcuts_controller.js). The judgement
    and the note to the participant belong to no verdict (D-112): they show from the start, under all four, and j and f always
    focus them. A ship sent back from its fraud check opens with its earlier
    review. What was typed before an error wins, then that review, then the defaults. %>
<% earlier = send_backs.last&.earlier_review || {} %>
<%# D-097: a later ship judges only the new hours. The earlier approval is fixed, and the coding and art boxes take the hours
    since it. The limits are read on the whole project (Ship::Limits#new_coding_top, #new_art_top). D-111: the tops are the
    limits' own, for a first ship too (no earlier approval is 0 and 0), so the form's defaults are what approving the most stores. %>
<% prior = ship.earlier_approval %>
<% prior_coding = prior ? prior.coding : 0.to_d %>
<% prior_art = prior ? prior.art : 0.to_d %>
<% coding_claimed = prior ? limits.new_coding_claimed(prior_coding) : limits.coding %>
<% art_claimed = prior ? limits.new_art_claimed(prior_art) : limits.art %>
<% art = limits.art_known? && art_claimed.positive? %>
<% coding_top = limits.new_coding_top(prior_coding, prior_art) %>
<%# A send-back keeps the earlier review's cumulative figures, so a later ship takes the earlier approval off them. %>
<% earlier_coding = earlier["coding_hours"] && [ earlier["coding_hours"].to_d - prior_coding, 0 ].max %>
<% earlier_art = earlier["art_hours"] && [ earlier["art_hours"].to_d - prior_art, 0 ].max %>
<% coding_now = params[:coding_hours].presence || (earlier_coding ? [ earlier_coding, coding_top ].min : coding_top) %>
<% art_top = limits.new_art_top(prior_coding, prior_art, [ coding_now.to_d, coding_top ].min) %>
<% art_top_at_cap = limits.new_art_top(prior_coding, prior_art, coding_top) %>
<% art_now = params[:art_hours].presence || (earlier_art ? [ earlier_art, art_top ].min : art_top) %>
<% art_max_now = prior ? [ limits.art_max_for(prior_coding + coding_now.to_d) - prior_art, 0 ].max : limits.art_max_for(coding_now.to_d) %>
<% format = Ship::Limits.method(:format) %>
<%# D-063 item 9: when the repo is shipped on Stardance, Stardance reviews it, so Approve is off (the evidence panel says why). %>
<% approve_off = @evidence&.stardance_shipped? %>

<%# D-112: "Why deflated" shows whenever the hours to approve fall below the hours claimed, the test approve_review makes (claimed > total,
    a hundredth counts). The figures are the ones approve_new would take from the form as drawn. An AI cut or the art hold shows it
    too, with the limits' own words beside it (limits.reason, which approve_review writes ahead of the reviewer's). D-106: a reason
    is due only below the most the rules allow (below_most). Elsewhere the reviewer's words are optional. deflate_controller.js keeps
    both current as the hours change. %>
<% coding_asked, art_asked, below_most = limits.approve_new(prior_coding, prior_art, coding_now.to_d, (art_now.to_d if art)) %>
<% deflated = limits.claimed > prior_coding + prior_art + coding_asked + art_asked %>
<% why_shown = deflated || below_most || ship.errors[:deflation_reason].any? %>
<%# A send-back refills the reason with the one stored, which begins with the limits' words. The app writes those itself, so only the reviewer's go back in. %>
<% earlier_why = earlier["deflation_reason"].to_s %>
<% earlier_why = earlier_why.sub(limits.reason, "").strip if limits.reason %>
<% picked = params[:decision].to_s.presence_in(Ship::DECISIONS) %>
<%# Which verdicts each field belongs to. Approve's fields and the ban evidence show only when their verdict is picked. The judgement and
    the note to the participant belong to none (D-112). %>
<% hide = ->(*verdicts) { verdicts.exclude?(picked) } %>

<%# D-102: the reviewer's AI coding hours, above Hackatime's only. Closed until a figure is set. Saved on its own like the Lapse
    split (D-085), then the page draws again. %>
<% ai_low = [ limits.hackatime_ai, ship.earlier_approval&.ship&.reviewer_ai_in_force.to_d ].max.floor(2) %>
<details class="ash__fold" id="raise-ai" <%= "open" if limits.ai_raised? %>>
  <summary class="ash__fold-summary">Raise AI coding <small class="admin__muted">Hackatime <%= format.(limits.hackatime_ai) %> hrs</small></summary>
  <%= form_with url: reviewer_ai_admin_ship_path(ship), method: :patch, class: "ash__hours-start-form", id: "reviewer-ai", data: { turbo: false } do |ai_form| %>
    <%= ai_form.hidden_field :queue, value: params[:queue].presence, id: nil if params[:queue].present? %>
    <div class="sp-field">
      <%= ai_form.label :reviewer_ai_coding_hours, "AI coding hours", class: "sp-label" %>
      <span class="ash__hours-box">
        <%# The placeholder is a String: Rails reads any other value as "look the attribute's name up". %>
        <%= ai_form.number_field :reviewer_ai_coding_hours, value: (limits.ai_coding.to_f if limits.ai_raised?), placeholder: format.(ai_low).to_s, min: ai_low.to_f, step: 0.01,
              class: "sp-input admin__hours ash__hours", aria: { describedby: "admin-ship-ai-help" } %>
        <span class="ash__hours-unit" aria-hidden="true">hrs</span>
      </span>
    </div>
    <div class="sp-field">
      <%= ai_form.label :reviewer_ai_reason, "Why (what looked AI-generated)", class: "sp-label" %>
      <%= ai_form.text_area :reviewer_ai_reason, value: ship.reviewer_ai_reason, rows: 2, class: "sp-input ash__textarea" %>
    </div>
    <div class="ash__hours-start-actions">
      <%= ai_form.button type: "submit", class: "sp-btn sp-btn--royal sp-btn--sm" do %><%= sp_icon "save-2-fill" %>Set AI coding<% end %>
    </div>
    <p class="admin__muted ash__hours-start-note" id="admin-ship-ai-help">Hackatime counts <%= format.(limits.hackatime_ai) %> hrs. Raise it when the code looks AI-generated, never lower it. Leave it empty to use Hackatime's figure. The coding maximum updates when you set it.</p>
  <% end %>
</details>

<%= render "admin/ships/checklist", ship:, checklist:, defaults:, ticked:, own: false %>

<%= form_with url: review_admin_ship_path(ship), method: :post, class: "ash__verdict-form", id: "verdict", html: { novalidate: true },
      data: { turbo: false, controller: "deflate verdict", verdict_picked_value: picked.to_s,
              deflate_claimed_value: coding_claimed.to_f, deflate_hours_claimed_value: limits.claimed.to_f, deflate_cap_value: coding_top.to_f,
              deflate_art_claimed_value: (art ? art_claimed.to_f : 0), deflate_art_top_value: (art ? art_top_at_cap.to_f : 0),
              deflate_art_percent_value: Ship::Limits::ART_CAP_PERCENT,
              deflate_earlier_coding_value: prior_coding.to_f, deflate_earlier_art_value: prior_art.to_f } do |form| %>
  <%= form.hidden_field :queue, value: params[:queue].presence, id: nil if params[:queue].present? %>

  <%# The four verdicts first. A press picks one (aria-pressed), and its key pressed again submits (shortcuts_controller.js). %>
  <div class="ash__verdicts" role="group" aria-label="Verdict">
    <%= form.button type: "button", disabled: approve_off, class: "sp-btn sp-btn--mint ash__verdict-btn", aria: { pressed: (picked == "approved").to_s },
          data: { verdict_target: "pick", verdict: "approved", action: "verdict#pick", shortcut: "a", shortcut_submit: "#verdict-submit" } do %><%= sp_icon "check-fill" %>Approve <kbd class="ash__kbd">a a</kbd><% end %>
    <%= form.button type: "button", class: "sp-btn ash__verdict-btn", aria: { pressed: (picked == "changes_needed").to_s },
          data: { verdict_target: "pick", verdict: "changes_needed", action: "verdict#pick", shortcut: "c", shortcut_submit: "#verdict-submit" } do %><%= sp_icon "refresh-2-fill" %>Changes needed <kbd class="ash__kbd">c c</kbd><% end %>
    <%= form.button type: "button", class: "sp-btn ash__verdict-btn ash__verdict-btn--coral", aria: { pressed: (picked == "rejected").to_s },
          data: { verdict_target: "pick", verdict: "rejected", action: "verdict#pick", shortcut: "r", shortcut_submit: "#verdict-submit" } do %><%= sp_icon "close-fill" %>Reject <kbd class="ash__kbd">r r</kbd><% end %>
    <%= form.button type: "button", class: "sp-btn ash__verdict-btn ash__verdict-btn--ban", aria: { pressed: (picked == "banned").to_s },
          data: { verdict_target: "pick", verdict: "banned", action: "verdict#pick", shortcut: "b", shortcut_submit: "#verdict-submit" } do %><%= sp_icon "warning-fill" %>Fraud: reject and ban <kbd class="ash__kbd">b b</kbd><% end %>
  </div>

  <%# Approve: the hours, why they went down, the features that explain them. %>
  <div class="ash__verdict-fields" data-verdict-target="fields" data-verdict-for="approved" <%= "hidden" if hide.("approved") %>>
    <% if prior %>
      <p class="ash__already" id="admin-ship-already-approved">Already approved: <strong><%= Ship::Limits.hrs(prior.hours) %></strong> (<%= prior.on.strftime("%b %-d") %> ship)</p>
    <% end %>

    <div class="sp-field">
      <%= form.label :coding_hours, (prior ? "New coding hours" : "Coding hours"), class: "sp-label" %>
      <span class="ash__hours-box">
        <%= form.number_field :coding_hours, value: coding_now.to_f, min: 0, max: coding_top.to_f, step: 0.01, class: "sp-input admin__hours ash__hours",
              data: { shortcut: "h", deflate_target: "coding", action: "input->deflate#changed" }, aria: { describedby: "admin-ship-coding-help" } %>
        <span class="ash__hours-unit" aria-hidden="true">hrs</span>
      </span>
      <span class="sp-help" id="admin-ship-coding-help"><%= prior ? "New since the earlier approval: claimed" : "Claimed" %> <%= format.(coding_claimed) %>. Up to <%= format.(coding_top) %> with the AI cut<%= " on the whole project" if prior %>. Deflate when the evidence says less.</span>
      <div class="ash__presets" role="group" aria-label="Deflate coding to a share of the claimed coding hours">
        <% [ 15, 30, 50, 75 ].each do |percent| %>
          <button type="button" class="sp-btn sp-btn--sm ash__preset" data-percent="<%= percent %>" data-action="deflate#setCoding"><%= percent %>% <small><%= format.(coding_claimed * percent / 100) %>h</small></button>
        <% end %>
      </div>
    </div>

    <% if art %>
      <div class="sp-field">
        <%= form.label :art_hours, (prior ? "New art hours" : "Art hours"), class: "sp-label" %>
        <span class="ash__hours-box">
          <%= form.number_field :art_hours, value: art_now.to_f, min: 0, max: [ art_claimed, art_top_at_cap ].max.to_f, step: 0.01, class: "sp-input admin__hours ash__hours",
                data: { deflate_target: "art", action: "input->deflate#changed" }, aria: { describedby: "admin-ship-art-help" } %>
          <span class="ash__hours-unit" aria-hidden="true">hrs</span>
        </span>
        <span class="sp-help" id="admin-ship-art-help">
          <%= prior ? "New since the earlier approval: claimed" : "Claimed" %> <%= format.(art_claimed) %>. At most <%= Ship::Limits::ART_CAP_PERCENT %>% of the total<%= " approved" if prior %>, so up to
          <strong data-deflate-target="artMax"><%= format.(art_max_now) %></strong> hrs with this coding.
        </span>
        <p class="ash__problem" data-deflate-target="hold" <%= "hidden" unless art_claimed > art_max_now %>><%= sp_icon "warning-fill" %>Art held at <%= Ship::Limits::ART_CAP_PERCENT %>% of the total. No reason needed.</p>
        <div class="ash__presets" role="group" aria-label="Deflate art to a share of the claimed art hours">
          <% [ 15, 30, 50, 75 ].each do |percent| %>
            <button type="button" class="sp-btn sp-btn--sm ash__preset" data-percent="<%= percent %>" data-action="deflate#setArt"><%= percent %>% <small><%= format.(art_claimed * percent / 100) %>h</small></button>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="sp-field" data-deflate-target="why" <%= "hidden" unless why_shown %>>
      <%= form.label :deflation_reason, "Why deflated", class: "sp-label" %>
      <% if limits.reason %>
        <%# What the rules cut, in the words approve_review writes into the record ahead of the reviewer's. %>
        <span class="sp-help" id="admin-ship-deflation-says"><%= sp_icon "information-fill" %><span>The app already writes this into the record: <%= limits.reason %></span></span>
      <% end %>
      <%= form.text_area :deflation_reason, value: params[:deflation_reason].presence || earlier_why.presence, rows: 3, class: "sp-input ash__textarea",
            aria: { describedby: [ ("admin-ship-deflation-says" if limits.reason), "admin-ship-deflation-help" ].compact.join(" ") } %>
      <span class="sp-help" id="admin-ship-deflation-help">
        <span data-deflate-target="whyRequired" <%= "hidden" unless below_most %>>Required: you approve less coding or art than the rules allow. Say why.</span>
        <span data-deflate-target="whyOptional" <%= "hidden" if below_most %>>Optional: the app's words above already cover this cut. Anything you add follows them.</span>
      </span>
      <% if ship.errors[:deflation_reason].any? %><span class="ash__error" role="alert"><%= sp_icon "warning-fill" %><%= ship.errors.messages_for(:deflation_reason).first %></span><% end %>
    </div>
    <div class="sp-field">
      <%= form.label :technical_features, "Specific technical features", class: "sp-label" %>
      <%= form.text_area :technical_features, value: ship.technical_features.presence || earlier["technical_features"], rows: 3, class: "sp-input ash__textarea",
            aria: { describedby: "admin-ship-features-help" } %>
      <span class="sp-help" id="admin-ship-features-help">Required to approve. Name the features that explain the hours, like custom jump physics or a save file. No praise.</span>
      <% if ship.errors[:technical_features].any? %><span class="ash__error" role="alert"><%= sp_icon "warning-fill" %><%= ship.errors.messages_for(:technical_features).first %></span><% end %>
    </div>
  </div>

  <%# The ban's own field, with Approve's above: what is particular to a verdict comes straight after the buttons. %>
  <div class="sp-field" data-verdict-target="fields" data-verdict-for="banned" <%= "hidden" if hide.("banned") %>>
    <%= form.label :evidence, "Ban evidence", class: "sp-label" %>
    <%= form.text_area :evidence, value: params[:evidence].presence || ship.fraud_notes, rows: 3, class: "sp-input ash__textarea",
          aria: { describedby: "admin-ship-evidence-help" } %>
    <span class="sp-help" id="admin-ship-evidence-help">Required only for fraud: reject and ban. Write what shows the fraud.</span>
    <% if ship.errors[:fraud_notes].any? %><span class="ash__error" role="alert"><%= sp_icon "warning-fill" %><%= ship.errors.messages_for(:fraud_notes).first %></span><% end %>
  </div>

  <%# D-112: the judgement and the note to the participant belong to no verdict. They show from the start and stay under all four, so j
      and f always focus them (shortcuts_controller.js skips a field inside [hidden]). Each verdict still wants only what it did:
      changes needed the note, reject the judgement. All four save both (Ship#decide_in_review). %>
  <div class="sp-field">
    <%= form.label :review_judgement, "Your judgement", class: "sp-label" %>
    <%= form.text_area :review_judgement, value: ship.review_judgement.presence || earlier["judgement"], rows: 3, class: "sp-input ash__textarea",
          data: { shortcut: "j" }, aria: { describedby: "admin-ship-judgement-help" } %>
    <span class="sp-help" id="admin-ship-judgement-help">Internal. Goes into the Airtable justification. Required to reject: say what is missing.</span>
    <% if ship.errors[:review_judgement].any? %><span class="ash__error" role="alert"><%= sp_icon "warning-fill" %><%= ship.errors.messages_for(:review_judgement).first %></span><% end %>
  </div>

  <div class="sp-field">
    <%= form.label :review_feedback, "Note to the participant", class: "sp-label" %>
    <%= form.text_area :review_feedback, value: ship.review_feedback.presence || earlier["feedback"], rows: 4, class: "sp-input ash__textarea",
          data: { shortcut: "f" }, aria: { describedby: "admin-ship-feedback-help" } %>
    <span class="sp-help" id="admin-ship-feedback-help">Shown to them. With Approve, it goes in their approval DM and on their project page. With Changes needed, it is required and shows on their ship page: say exactly what to change. With Reject or Ban, it shows on their rejected ship page.</span>
    <% if ship.errors[:review_feedback].any? %><span class="ash__error" role="alert"><%= sp_icon "warning-fill" %><%= ship.errors.messages_for(:review_feedback).first %></span><% end %>
  </div>

  <%# One submit button, named for the picked verdict. Its value is set when a verdict is picked. %>
  <%= form.button type: "submit", name: "decision", value: picked.to_s, id: "verdict-submit", hidden: picked.nil?, class: "sp-btn ash__verdict-btn ash__submit",
        data: { verdict_target: "submit" } do %>
    <span data-verdict-label="approved" <%= "hidden" unless picked == "approved" %>><%= sp_icon "check-fill" %>Approve <strong data-deflate-target="total"><%= (prior ? prior.hours : 0).to_d.then { |base| (base + coding_now.to_d + (art ? art_now.to_d : 0)).round(2).to_f } %></strong> hrs<%= " in all" if prior %></span>
    <span data-verdict-label="changes_needed" <%= "hidden" unless picked == "changes_needed" %>><%= sp_icon "refresh-2-fill" %>Send changes needed</span>
    <span data-verdict-label="rejected" <%= "hidden" unless picked == "rejected" %>><%= sp_icon "close-fill" %>Reject ship</span>
    <span data-verdict-label="banned" <%= "hidden" unless picked == "banned" %>><%= sp_icon "warning-fill" %>Ban and reject</span>
  <% end %>
  <p class="leaderboard__note ash__note"><kbd class="ash__kbd">h</kbd> coding hours <kbd class="ash__kbd">j</kbd> judgement <kbd class="ash__kbd">f</kbd> note. A verdict key picks it. Press it again to send.</p>
<% end %>
